# Copia este archivo como .env y rellena las API Keys que vayas a usar
GOOGLE_API_KEY=tu_clave_gemini
OPENAI_API_KEY=tu_clave_openai
OPENROUTER_API_KEY=tu_clave_openrouter

# Configuración del Motor RAG para la API Externa
CHAT_PROVIDER=Gemini
EMBED_PROVIDER=Gemini
OPENROUTER_MODEL=anthropic/claude-3-haiku

# Seguridad
ADMIN_PASSWORD=admin123
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5500
WIDGET_API_KEY=tu_clave_secreta_para_el_widget

# Puertos y bootstrap
UI_PORT=8501
API_PORT=8000
ROBOTITO_BOOTSTRAP_ENGINE=false
